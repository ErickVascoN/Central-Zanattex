DJANGO_SECRET_KEY=troque-por-uma-chave-nova-e-secreta
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=meudominio.com,www.meudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://meudominio.com,https://www.meudominio.com
DATABASE_URL=postgres://usuario:senha@localhost:5432/central_zanattex

# Gestão de OP (controle_op) ainda em desenvolvimento — deixe False (ou
# omita, o padrão já é False) em produção. Ligue True só pra testar
# localmente (ver central/settings.py::GESTAO_OP_HABILITADA).
GESTAO_OP_HABILITADA=False

# Base fixa pra links mandados pra fora do sistema (ex.: link do prestador
# disparado por WhatsApp) — em produção, o domínio real, sem barra no fim.
SITE_URL=https://meudominio.com

# Envio automático diário de relatórios (relatorios/cron.py) — opcional em dev
# (sem essas variáveis, o backend cai pra console em DEBUG e o token vazio
# faz o endpoint recusar qualquer chamada).
EMAIL_HOST=smtp.seuservidor.com
EMAIL_PORT=587
EMAIL_HOST_USER=relatorios@zanattex.com.br
EMAIL_HOST_PASSWORD=troque-por-uma-senha-de-app
EMAIL_USE_TLS=True
REPORT_TRIGGER_TOKEN=gere-com-openssl-rand-hex-32
RELATORIOS_EMAIL_TO=fulano@zanattex.com.br,ciclano@zanattex.com.br

# Consulta ao SEFAZ pra detectar NF-e canceladas (fiscal/sefaz.py) — opcional
# em dev (sem FISCAL_SEFAZ_CERTIFICADOS_JSON, toda consulta vira "não
# verificada", sem erro). Começar sempre com FISCAL_SEFAZ_AMBIENTE=homologacao.
FISCAL_SEFAZ_AMBIENTE=homologacao
# JSON {"<cnpj>": {"pfx_b64": "...", "senha": "..."}, ...} em base64 — NUNCA
# o .pfx em disco. Gere com: base64 -w0 certificado.json (depois de montar o
# JSON com o .pfx já em base64 dentro dele).
FISCAL_SEFAZ_CERTIFICADOS_JSON=
FISCAL_SEFAZ_TIMEOUT_SEGUNDOS=3.0
FISCAL_SEFAZ_MAX_PARALELO=10
FISCAL_SEFAZ_LOTE_CRON=200
FISCAL_MAX_ARQUIVOS_POR_ENVIO=1000
